// Prisma schema for UniCareer Community
// Stage 6: Companies, Opportunities & Moderation Engine

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipType {
  STUDENT
  ALUMNI
  ADMIN
}

enum SystemRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum OpportunityType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
  OTHER
}

enum OpportunitySourceType {
  OFFICIAL_EMPLOYER
  COMMUNITY_SHARED
}

enum OpportunityStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CLOSED
}

enum WorkplaceType {
  ON_SITE
  REMOTE
  HYBRID
}

enum ApplicationMethod {
  INTERNAL
  EXTERNAL
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum SkillCategory {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  DATABASE
  DEVOPS
  CLOUD
  DATA_AI
  DESIGN
  MOBILE
  SECURITY
  MANAGEMENT
  SOFT_SKILLS
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  email                String             @unique
  emailVerified        Boolean            @default(false)
  image                String?
  membershipType       MembershipType     @default(STUDENT)
  systemRole           SystemRole         @default(MEMBER)
  accountStatus        AccountStatus      @default(ACTIVE)
  verificationStatus   VerificationStatus @default(PENDING)
  canPostOpportunities Boolean            @default(false)
  canReviewApplicants  Boolean            @default(false)
  verifiedAt           DateTime?
  verifiedBy           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  sessions             Session[]
  accounts             Account[]
  profile              Profile?
  membershipRequests   MembershipRequest[] @relation("UserMembershipRequests")
  reviewedRequests     MembershipRequest[] @relation("ReviewedRequests")

  // Stage 6: Company & Opportunity Relations
  createdCompanies        Company[]             @relation("CreatedCompanies")
  companyMemberships      CompanyMember[]
  postedOpportunities     Opportunity[]         @relation("PostedOpportunities")
  reviewedOpportunities   Opportunity[]         @relation("ReviewedOpportunities")
  bookmarkedOpportunities OpportunityBookmark[]

  // Stage 8: Applications & Resumes Relations
  resumes                 Resume[]
  applications            Application[]         @relation("UserApplications")
  manualApplications      ManualApplication[]
  reviewedApplications    Application[]         @relation("ReviewedApplications")
  changedApplicationStatuses ApplicationStatusHistory[] @relation("ChangedApplicationStatuses")

  // Stage 9: Community Feed & Discussions Relations
  posts                   Post[]                @relation("UserPosts")
  comments                Comment[]             @relation("UserComments")
  opportunityComments     OpportunityComment[]
  postReactions           PostReaction[]        @relation("UserPostReactions")
  bookmarkedPosts         PostBookmark[]        @relation("UserPostBookmarks")
  submittedReports        ContentReport[]       @relation("UserSubmittedReports")
  reviewedReports         ContentReport[]       @relation("ReviewedReports")

  // Stage 10: Connections & Referrals Relations
  sentConnections         Connection[]          @relation("SentConnections")
  receivedConnections     Connection[]          @relation("ReceivedConnections")
  sentReferrals           ReferralRequest[]     @relation("SentReferrals")
  receivedReferrals       ReferralRequest[]     @relation("ReceivedReferrals")

  // Stage 11: Academic Records & Career Tools
  academicRecords         AcademicRecord[]      @relation("UserAcademicRecords")

  // Stage 12: Notifications, Preferences & Career Calendar
  notifications           Notification[]        @relation("UserNotifications")
  notificationPreference  NotificationPreference?
  calendarEvents          CareerCalendarEvent[] @relation("UserCalendarEvents")
  reminderLogs            DeadlineReminderLog[] @relation("UserReminderLogs")

  // Stage 13: Admin Governance & Audit Logs
  adminAuditLogs          AdminAuditLog[]       @relation("AdminActionLogs")

  @@map("users")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  website     String?
  industry    String?
  location    String?
  isVerified  Boolean  @default(false)
  isSuspended Boolean  @default(false)
  createdById String
  createdBy   User     @relation("CreatedCompanies", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members          CompanyMember[]
  opportunities    Opportunity[]
  referralRequests ReferralRequest[]

  @@index([name])
  @@index([isVerified])
  @@index([isSuspended])
  @@map("companies")
}

model CompanyMember {
  id                   String            @id @default(cuid())
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 CompanyMemberRole @default(MEMBER)
  canPostOpportunities Boolean           @default(true)
  canManageCompany     Boolean           @default(false)
  title                String?           // e.g. "Senior Campus Recruiter"
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
  @@map("company_members")
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "CSE", "EEE", "BBA", "MATH"
  name      String   @unique // e.g. "Computer Science & Engineering"
  faculty   String   // e.g. "Faculty of Science", "Faculty of Business Studies"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Opportunity {
  id                    String                @id @default(cuid())
  title                 String
  description           String
  companyId             String?
  company               Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName           String                // Denormalized for community-shared posts
  companyLogo           String?
  type                  OpportunityType       @default(FULL_TIME)
  posterId              String
  poster                User                  @relation("PostedOpportunities", fields: [posterId], references: [id], onDelete: Cascade)
  sourceType            OpportunitySourceType @default(COMMUNITY_SHARED)
  status                OpportunityStatus     @default(PENDING)

  // Academic Targeting & Eligibility Criteria
  minCgpa               Float?
  minAcademicYear       String?               // e.g. "3rd Year", "Senior", "Graduate"
  requiredSkills        String[]              @default([])
  targetDepartments     String[]              @default([]) // Canonical department names/codes
  openToAllDepartments  Boolean               @default(true)

  // Compensation & Working Model
  salaryOrStipend       String?
  location              String
  workplaceType         WorkplaceType         @default(ON_SITE)

  // Application Method & Routing
  applicationMethod     ApplicationMethod     @default(INTERNAL)
  externalUrl           String?
  contactEmail          String?
  deadline              DateTime

  // Administrative Moderation
  reviewerId            String?
  reviewer              User?                 @relation("ReviewedOpportunities", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  rejectionReason       String?

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  bookmarks             OpportunityBookmark[]
  applications          Application[]
  comments              OpportunityComment[]
  referencingPosts      Post[]                @relation("OpportunityPosts")
  referralRequests      ReferralRequest[]     @relation("ReferralOpportunities")
  opportunitySkills     OpportunitySkill[]

  @@index([status, deadline])
  @@index([companyId])
  @@index([posterId])
  @@index([sourceType])
  @@map("opportunities")
}

model OpportunityBookmark {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
  @@map("opportunity_bookmarks")
}

// Stage 8: Secure Resume Storage & Application Systems
model Resume {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String        @map("file_name")
  fileSize     Int           @map("file_size") // bytes
  mimeType     String        @map("mime_type")
  storageKey   String        @unique @map("storage_key")
  isDefault    Boolean       @default(false) @map("is_default")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  applications Application[]

  @@index([userId])
  @@map("resumes")
}

model Application {
  id                 String                   @id @default(cuid())
  opportunityId      String                   @map("opportunity_id")
  opportunity        Opportunity              @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId        String                   @map("applicant_id")
  applicant          User                     @relation("UserApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  resumeId           String?                  @map("resume_id")
  resume             Resume?                  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeFileName     String?                  @map("resume_file_name")
  coverLetter        String?                  @map("cover_letter") @db.Text
  method             ApplicationMethod        @default(INTERNAL)
  status             ApplicationStatus        @default(SUBMITTED)
  externalAppliedAt  DateTime?                @map("external_applied_at")
  externalNotes      String?                  @map("external_notes")
  employerNotes      String?                  @map("employer_notes") @db.Text
  reviewedById       String?                  @map("reviewed_by_id")
  reviewedBy         User?                    @relation("ReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?                @map("reviewed_at")
  submittedAt        DateTime                 @default(now()) @map("submitted_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  statusHistory      ApplicationStatusHistory[]

  @@unique([opportunityId, applicantId])
  @@index([opportunityId])
  @@index([applicantId])
  @@index([status])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String?           @db.Text
  changedById   String?           @map("changed_by_id")
  changedBy     User?             @relation("ChangedApplicationStatuses", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("application_status_history")
}

model Profile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline       String?
  bio            String?
  department     String?

  // Academic Information (studentId is PRIVATE: visible only to self & Admin)
  studentId      String?
  academicYear   String?
  graduationYear Int?
  degree         String?
  currentCgpa    Float?
  isCgpaVerified Boolean   @default(false) @map("is_cgpa_verified")

  // Professional Information
  company        String?
  designation    String?

  // Structured Information
  skills         String[]  @default([])
  interests      String[]  @default([])
  memberSkills   MemberSkill[]
  projects       Json?     // Array of { id, title, description, link, techStack }
  experience     Json?     // Array of { id, company, role, period, description }

  // Social & Professional Profiles
  linkedinUrl    String?
  githubUrl      String?
  websiteUrl     String?

  // Privacy & Contact Preferences
  phone          String?   // PRIVATE: visible only to self & Admin
  showEmail      Boolean   @default(false)

  // Onboarding lifecycle flag
  isOnboarded    Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("profiles")
}

model MembershipRequest {
  id               String                    @id @default(cuid())
  userId           String
  user             User                      @relation("UserMembershipRequests", fields: [userId], references: [id], onDelete: Cascade)

  membershipType   MembershipType
  status           VerificationRequestStatus @default(PENDING)

  // Institutional Claims & Verification Dossier (PRIVATE)
  institutionalId  String?
  department       String?
  academicYear     String?
  graduationYear   Int?
  organization     String?
  designation      String?
  workEmail        String?
  connectionNote   String?
  proofDetails     String?
  proofDocumentUrl String?

  // Governance Audit
  reviewerId       String?
  reviewer         User?                     @relation("ReviewedRequests", fields: [reviewerId], references: [id])
  rejectionReason  String?
  reviewedAt       DateTime?

  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@map("membership_requests")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// ----------------------------------------------------------------------
// STAGE 9: COMMUNITY FEED, DISCUSSIONS & MODERATION
// ----------------------------------------------------------------------

enum PostType {
  GENERAL_DISCUSSION
  JOB_ANNOUNCEMENT
  REFERRAL_REQUEST
  ACHIEVEMENT
}

enum ModerationStatus {
  ACTIVE
  PENDING_REVIEW
  FLAGGED
  REMOVED
}

enum PostVisibility {
  PUBLIC
  STUDENTS_ONLY
  ALUMNI_ONLY
}

enum ReactionType {
  LIKE
  INSIGHTFUL
  SUPPORT
  CELEBRATE
}

enum ReportTargetType {
  POST
  COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Post {
  id                    String            @id @default(cuid())
  authorId              String            @map("author_id")
  author                User              @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  title                 String?
  content               String            @db.Text
  postType              PostType          @default(GENERAL_DISCUSSION) @map("post_type")
  visibility            PostVisibility    @default(PUBLIC)
  status                ModerationStatus  @default(ACTIVE)
  isPinned              Boolean           @default(false) @map("is_pinned")
  attachedOpportunityId String?           @map("attached_opportunity_id")
  attachedOpportunity   Opportunity?      @relation("OpportunityPosts", fields: [attachedOpportunityId], references: [id], onDelete: SetNull)
  tags                  String[]          @default([])
  viewsCount            Int               @default(0) @map("views_count")
  likesCount            Int               @default(0) @map("likes_count")
  commentsCount         Int               @default(0) @map("comments_count")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  comments              Comment[]
  reactions             PostReaction[]
  bookmarks             PostBookmark[]
  reports               ContentReport[]   @relation("ReportedPosts")

  @@index([authorId])
  @@index([postType])
  @@index([status])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id          String            @id @default(cuid())
  postId      String            @map("post_id")
  post        Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String            @map("author_id")
  author      User              @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?           @map("parent_id")
  parent      Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]         @relation("CommentReplies")
  content     String            @db.Text
  status      ModerationStatus  @default(ACTIVE)
  likesCount  Int               @default(0) @map("likes_count")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  reports     ContentReport[]   @relation("ReportedComments")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
  @@map("comments")
}

model PostReaction {
  id        String        @id @default(cuid())
  postId    String        @map("post_id")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  user      User          @relation("UserPostReactions", fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType  @default(LIKE)
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
  @@map("post_reactions")
}

model PostBookmark {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation("UserPostBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
  @@map("post_bookmarks")
}

model ContentReport {
  id           String           @id @default(cuid())
  reporterId   String           @map("reporter_id")
  reporter     User             @relation("UserSubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType @map("target_type")
  postId       String?          @map("post_id")
  post         Post?            @relation("ReportedPosts", fields: [postId], references: [id], onDelete: Cascade)
  commentId    String?          @map("comment_id")
  comment      Comment?         @relation("ReportedComments", fields: [commentId], references: [id], onDelete: Cascade)
  reason       ReportReason     @default(OTHER)
  description  String?          @db.Text
  status       ReportStatus     @default(PENDING)
  reviewedById String?          @map("reviewed_by_id")
  reviewedBy   User?            @relation("ReviewedReports", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes  String?          @map("review_notes") @db.Text
  reviewedAt   DateTime?        @map("reviewed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([targetType, postId])
  @@index([targetType, commentId])
  @@index([status])
  @@index([reporterId])
  @@map("content_reports")
}

// Stage 10: Connections & Referrals Models

model Connection {
  id         String           @id @default(cuid())
  senderId   String           @map("sender_id")
  sender     User             @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String           @map("receiver_id")
  receiver   User             @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("connections")
}

model ReferralRequest {
  id            String         @id @default(cuid())
  requesterId   String         @map("requester_id")
  requester     User           @relation("SentReferrals", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId   String         @map("recipient_id")
  recipient     User           @relation("ReceivedReferrals", fields: [recipientId], references: [id], onDelete: Cascade)
  companyId     String?        @map("company_id")
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName   String         @map("company_name")
  roleTitle     String         @map("role_title")
  opportunityId String?        @map("opportunity_id")
  opportunity   Opportunity?   @relation("ReferralOpportunities", fields: [opportunityId], references: [id], onDelete: SetNull)
  message       String         @db.Text
  resumeUrl     String?        @map("resume_url")
  status        ReferralStatus @default(PENDING)
  responseNote  String?        @map("response_note") @db.Text
  respondedAt   DateTime?      @map("responded_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
  @@map("referral_requests")
}

// Stage 11: Skills & Academic Records Models

model Skill {
  id                String             @id @default(cuid())
  name              String             @unique
  category          SkillCategory      @default(OTHER)
  description       String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  memberSkills      MemberSkill[]
  opportunitySkills OpportunitySkill[]

  @@index([category])
  @@map("skills")
}

model MemberSkill {
  id        String     @id @default(cuid())
  profileId String     @map("profile_id")
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String     @map("skill_id")
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     SkillLevel @default(INTERMEDIATE)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([profileId, skillId])
  @@index([profileId])
  @@index([skillId])
  @@map("member_skills")
}

model OpportunitySkill {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillId       String      @map("skill_id")
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  isMandatory   Boolean     @default(true) @map("is_mandatory")
  minLevel      SkillLevel? @map("min_level")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([opportunityId, skillId])
  @@index([opportunityId])
  @@index([skillId])
  @@map("opportunity_skills")
}

model AcademicRecord {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation("UserAcademicRecords", fields: [userId], references: [id], onDelete: Cascade)
  semester     String   // e.g. "Fall 2024", "Spring 2025"
  gpa          Float    // Semester GPA (0.00 - 4.00)
  credits      Float    @default(3.0) // Credit hours e.g. 3.0 or semester total
  academicYear String?  @map("academic_year") // e.g. "1st Year", "2nd Year", "3rd Year", "4th Year"
  notes        String?  // Optional honors / coursework notes
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, semester])
  @@index([userId])
  @@map("academic_records")
}

// =========================================================================
// STAGE 12: Notifications, Preferences & Career Calendar
// =========================================================================

enum NotificationType {
  // Opportunities
  OPPORTUNITY_MATCH
  OPPORTUNITY_DEADLINE_APPROACHING
  OPPORTUNITY_APPROVED
  OPPORTUNITY_REJECTED
  OPPORTUNITY_CLOSED
  OPPORTUNITY_EXPIRED

  // Applications
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  APPLICATION_SHORTLISTED
  APPLICATION_INTERVIEW_SCHEDULED
  APPLICATION_WITHDRAWN

  // Community
  POST_COMMENT
  COMMENT_REPLY
  POST_REACTION
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  REFERRAL_REQUEST
  REFERRAL_RESPONSE

  // Membership
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
  MEMBERSHIP_INFO_REQUIRED

  // Reminders & System
  CAREER_REMINDER
  SYSTEM_ANNOUNCEMENT
}

enum RelatedEntityType {
  OPPORTUNITY
  APPLICATION
  POST
  COMMENT
  CONNECTION
  REFERRAL
  MEMBERSHIP
  CALENDAR_EVENT
  SYSTEM
}

enum CalendarEventType {
  APPLICATION_DEADLINE
  SAVED_OPPORTUNITY_DEADLINE
  INTERVIEW
  CAREER_FAIR
  REMINDER
  OTHER
}

model Notification {
  id                String            @id @default(cuid())
  recipientId       String            @map("recipient_id")
  recipient         User              @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  relatedEntityType RelatedEntityType? @map("related_entity_type")
  relatedEntityId   String?           @map("related_entity_id")
  actionUrl         String?           @map("action_url")
  isRead            Boolean           @default(false) @map("is_read")
  readAt            DateTime?         @map("read_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@map("notifications")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // In-App Notification toggles
  opportunitiesInApp Boolean  @default(true) @map("opportunities_in_app")
  applicationsInApp  Boolean  @default(true) @map("applications_in_app")
  communityInApp     Boolean  @default(true) @map("community_in_app")
  membershipInApp    Boolean  @default(true) @map("membership_in_app")
  remindersInApp     Boolean  @default(true) @map("reminders_in_app")

  // Email Notification toggles
  opportunitiesEmail Boolean  @default(true) @map("opportunities_email")
  applicationsEmail  Boolean  @default(true) @map("applications_email")
  communityEmail     Boolean  @default(false) @map("community_email") // Low frequency default
  membershipEmail    Boolean  @default(true) @map("membership_email")
  remindersEmail     Boolean  @default(true) @map("reminders_email")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model CareerCalendarEvent {
  id                    String            @id @default(cuid())
  userId                String            @map("user_id")
  user                  User              @relation("UserCalendarEvents", fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  eventType             CalendarEventType @default(REMINDER) @map("event_type")
  startDate             DateTime          @map("start_date")
  endDate               DateTime?         @map("end_date")
  location              String?
  isAllDay              Boolean           @default(false) @map("is_all_day")
  relatedOpportunityId  String?           @map("related_opportunity_id")
  relatedApplicationId  String?           @map("related_application_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([userId, startDate])
  @@map("career_calendar_events")
}

model DeadlineReminderLog {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation("UserReminderLogs", fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String?  @map("opportunity_id")
  applicationId String?  @map("application_id")
  reminderType  String   @map("reminder_type") // e.g. "DEADLINE_3_DAYS", "DEADLINE_24_HOURS", "INTERVIEW_24_HOURS"
  channel       String   @default("IN_APP") // "IN_APP" | "EMAIL"
  sentAt        DateTime @default(now()) @map("sent_at")

  @@unique([userId, opportunityId, reminderType, channel])
  @@index([userId])
  @@map("deadline_reminder_logs")
}

// ----------------------------------------------------------------------
// STAGE 13: ADMINISTRATIVE GOVERNANCE, AUDIT LOGGING & MODERATION
// ----------------------------------------------------------------------

enum AdminAuditAction {
  MEMBER_VERIFIED
  MEMBER_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_RESTORED
  OPPORTUNITY_APPROVED
  OPPORTUNITY_REJECTED
  OPPORTUNITY_CLOSED
  OPPORTUNITY_DELETED
  CONTENT_REPORT_RESOLVED
  CONTENT_REPORT_DISMISSED
  POST_REMOVED
  COMMENT_REMOVED
  COMPANY_VERIFIED
  COMPANY_SUSPENDED
  COMPANY_RESTORED
  SYSTEM_SETTINGS_UPDATED
}

enum AuditTargetType {
  USER
  OPPORTUNITY
  COMPANY
  POST
  COMMENT
  REPORT
  SETTINGS
}

model AdminAuditLog {
  id          String           @id @default(cuid())
  adminId     String           @map("admin_id")
  admin       User             @relation("AdminActionLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action      AdminAuditAction
  targetType  AuditTargetType  @map("target_type")
  targetId    String           @map("target_id")
  targetLabel String?          @map("target_label") // Human-readable identifier (e.g. member name, opportunity title)
  reason      String?          @db.Text
  details     Json?            // Additional audit context/metadata
  ipAddress   String?          @map("ip_address")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model ManualApplication {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String   @map("company_name")
  roleTitle   String   @map("role_title")
  location    String?
  jobUrl      String?  @map("job_url")
  notes       String?  @db.Text
  status      String   @default("APPLIED") // APPLIED, INTERVIEWING, OFFERED, REJECTED
  appliedDate DateTime @default(now()) @map("applied_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("manual_applications")
}

model OpportunityComment {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  authorId      String      @map("author_id")
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([opportunityId])
  @@index([authorId])
  @@map("opportunity_comments")
}





