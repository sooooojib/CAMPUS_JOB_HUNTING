# ==========================================
# UniCareer Community — Environment Variables
# ==========================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="UniCareer Community"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL / Neon Lakebase)
DATABASE_URL="postgresql://user:password@ep-pooler.region.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep.region.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Authentication & Session Secrets
AUTH_SECRET="your-32-character-secret-key-change-in-production"
AUTH_TRUST_HOST="true"
BETTER_AUTH_URL="https://jnujobhunting.vercel.app" # Or http://localhost:3000 locally
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://*.vercel.app,https://jnujobhunting.vercel.app"

# Private Storage Configuration (Resumes & Documents)
STORAGE_PROVIDER="local" # or "s3" | "gcs"
STORAGE_BUCKET_NAME="unicareer-private-vault"
STORAGE_SIGNED_URL_EXPIRES_IN="900" # 15 minutes in seconds

# Logging
LOG_LEVEL="debug" # "debug" | "info" | "warn" | "error"


# Email Dispatcher (Resend)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="UniCareer <onboarding@resend.dev>"


# Email Dispatcher (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
EMAIL_FROM="\"UniCareer Community\" <your-email@gmail.com>"

